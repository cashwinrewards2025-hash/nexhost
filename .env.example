APP_NAME="NexHost"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexhost
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nexhost.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINTS=false

IPSTACK_API_KEY=
IPSTACK_ENDPOINT=https://api.ipstack.com

PROMETHEUS_URL=http://localhost:9090
UPTIME_ROBOT_API_KEY=

PDF_STORAGE_PATH=/storage/pdfs
PDF_OWNER_PASSWORD=nexhost_secure
PDF_USER_PASSWORD=
PDF_ENCRYPTION_LEVEL=256

HEALTH_SCORE_UPTIME_WEIGHT=25
HEALTH_SCORE_CPU_WEIGHT=10
HEALTH_SCORE_RAM_WEIGHT=10
HEALTH_SCORE_DISK_WEIGHT=10
HEALTH_SCORE_RESPONSE_TIME_WEIGHT=15
HEALTH_SCORE_ERROR_RATE_WEIGHT=10
HEALTH_SCORE_SSL_WEIGHT=5
HEALTH_SCORE_BACKUP_WEIGHT=5
HEALTH_SCORE_DATABASE_WEIGHT=5
HEALTH_SCORE_NETWORK_WEIGHT=5

MONITORING_AGENT_TOKEN_EXPIRY=90
MONITORING_METRIC_RETENTION_DAYS=90
MONITORING_CHECK_INTERVAL=300

GST_RATE=18
CGST_RATE=9
SGST_RATE=9
IGST_RATE=18
DEFAULT_TAX_TYPE=GST

INVOICE_PREFIX=NXH-INV
REPORT_PREFIX=NXH-REP
INVOICE_YEAR_START=01

BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

DEMO_MODE=false
DEMO_DATA_ENABLED=false
